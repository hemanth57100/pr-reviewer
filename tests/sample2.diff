@@ -0,0 +1,9 @@
+export function showBanner(el: HTMLElement, userName: string): void {
+  el.innerHTML = '<div class="banner"><span class="name"></span></div>';
+  const span = el.querySelector('.name') as HTMLElement;
+  span.textContent = userName;
+}
+
+export function sum(prices: number[]): number {
+  return prices.reduce((a, b) => a + b, 0);
+}
